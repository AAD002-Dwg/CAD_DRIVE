# ==========================================
# Google Cloud Platform Configuration
# ==========================================
# Obtén estas credenciales en https://console.cloud.google.com/

# 1. Clave de API de Google (restringida a tus dominios en Cloud Console)
VITE_GOOGLE_API_KEY=tu_google_api_key_aqui

# 2. ID de cliente OAuth 2.0 (Tipo: Aplicación web con orígenes JavaScript autorizados)
VITE_GOOGLE_CLIENT_ID=tu_cliente_id.apps.googleusercontent.com

# 3. ID del Proyecto en Google Cloud (Project ID o Project Number)
VITE_GOOGLE_PROJECT_ID=tu_project_id_o_numero

# ==========================================
# Firebase Configuration
# ==========================================
# Obtén estas credenciales en https://console.firebase.google.com/
# Proyecto > Configuración > Tus apps > SDK Config

VITE_FIREBASE_API_KEY=tu_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
